        <intent android:action="sk.cartracker.shortcut.PARKING" android:targetPackage="sk.cartracker" android:targetClass="sk.cartracker.ui.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="refuel" android:enabled="true" android:icon="@drawable/sc_refuel"
