<?xml version="1.0" encoding="utf-8"?>
<!-- Skratky na ikone aplikácie (podržte ikonu Trasník na ploche) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="drive" android:enabled="true" android:icon="@drawable/sc_drive"
        android:shortcutShortLabel="@string/sc_drive" android:shortcutLongLabel="@string/sc_drive_long">
        <intent android:action="sk.cartracker.shortcut.DRIVE" android:targetPackage="sk.cartracker" android:targetClass="sk.cartracker.ui.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="walk" android:enabled="true" android:icon="@drawable/sc_walk"
