<?xml version="1.0" encoding="utf-8"?>
<!-- Pozadie widgetu: tmavý prechod + farebná žiara podľa stavu -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="300" android:startColor="#F20B1220" android:endColor="#F21B2638" android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="95%" android:centerX="1.0" android:centerY="0.0"
                android:startColor="#666366F1" android:endColor="#00000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="70%" android:centerX="0.0" android:centerY="1.0"
                android:startColor="#1F6366F1" android:endColor="#00000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
