<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg_idle" android:orientation="vertical" android:padding="16dp">

    <!-- hlavička: stav, vozidlo, obnoviť -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_pill" android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/wg_pill"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="11dp">
            <ImageView android:id="@+id/w_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trasník" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView android:id="@+id/w_vehicle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textColor="#80FFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="end" android:layout_marginStart="8dp" android:layout_marginEnd="4dp"/>
        <ImageView android:id="@+id/w_btn_refresh" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_w_refresh" android:tint="#99FFFFFF" android:scaleType="fitCenter" android:padding="5dp"/>
    </LinearLayout>

    <!-- dnes (keď nejazdíte) -->
    <LinearLayout android:id="@+id/w_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:gravity="bottom" android:orientation="horizontal">
        <TextView android:id="@+id/w_hero_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFFFF" android:textSize="40sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.03"/>
        <TextView android:id="@+id/w_hero_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km" android:textColor="#B3FFFFFF" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginStart="4dp" android:layout_marginBottom="5dp"/>
        <TextView android:id="@+id/w_hero_sub" android:layout_width="0dp" android:layout_height="wrap_content" android:text="dnes autom" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="end" android:layout_marginBottom="5dp"/>
    </LinearLayout>

    <!-- počas jazdy / chôdze -->
    <LinearLayout android:id="@+id/w_live" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFFFF" android:textSize="46sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.03"/>
                <TextView android:id="@+id/w_big_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km/h" android:textColor="#B3FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginStart="5dp" android:layout_marginBottom="6dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_clock_ic" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_w_clock" android:tint="#B3FFFFFF" android:scaleType="fitCenter" />
                <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:textColor="#FFFFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/w_live_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#B3FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/w_limit" android:layout_width="54dp" android:layout_height="54dp" android:visibility="gone" />
    </LinearLayout>

    <!-- dnešné čísla -->
    <LinearLayout android:id="@+id/w_tiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/wg_tile"
            android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp" >
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_t1i" android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_w_route" android:tint="#FF94A3B8" android:scaleType="fitCenter" />
                <TextView android:id="@+id/w_t1l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="jazdy" android:textColor="#B3FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView android:id="@+id/w_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="#FFFFFFFF" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/wg_tile"
            android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp" >
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_t2i" android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_walk" android:tint="#FF94A3B8" android:scaleType="fitCenter" />
                <TextView android:id="@+id/w_t2l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="kroky" android:textColor="#B3FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView android:id="@+id/w_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="#FFFFFFFF" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/wg_tile"
            android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp" >
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_t3i" android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_w_euro" android:tint="#FF94A3B8" android:scaleType="fitCenter" />
                <TextView android:id="@+id/w_t3l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="náklady" android:textColor="#B3FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView android:id="@+id/w_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="#FFFFFFFF" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- graf (prepína sa ťuknutím) + krúžok krokov -->
    <LinearLayout android:id="@+id/w_week_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <LinearLayout android:id="@+id/w_chart_box" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@drawable/wg_tile" android:orientation="vertical" android:padding="10dp">
            <TextView android:id="@+id/w_week_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Posledných 7 dní" android:textColor="#B3FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <ImageView android:id="@+id/w_chart" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="4dp" android:scaleType="fitXY" />
        </LinearLayout>
        <ImageView android:id="@+id/w_ring" android:layout_width="96dp" android:layout_height="96dp" android:layout_marginStart="8dp" android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- posledná jazda -->
    <LinearLayout android:id="@+id/w_trip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:background="@drawable/wg_tile" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
        <ImageView android:id="@+id/w_trip_map" android:layout_width="64dp" android:layout_height="52dp" android:scaleType="fitCenter" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/w_trip_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/w_trip_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
        </LinearLayout>
        <TextView android:id="@+id/w_trip_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:background="@drawable/wg_pill" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- pripomienka / parkovanie -->
    <LinearLayout android:id="@+id/w_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/w_info_ic" android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_w_bell" android:tint="#FFFBBF24" android:scaleType="fitCenter" />
        <TextView android:id="@+id/w_info_tx" android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textColor="#FFFDE68A" android:layout_weight="1" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- tlačidlá -->
    <LinearLayout android:id="@+id/w_buttons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_b1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="@drawable/wg_btn_primary"
            android:gravity="center" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
            <ImageView android:id="@+id/w_b1_ic" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_car" android:tint="#FF0B1220" android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_b1_tx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jazda" android:textColor="#FF0B1220" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
        <LinearLayout android:id="@+id/w_b2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="@drawable/wg_btn_secondary"
            android:gravity="center" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
            <ImageView android:id="@+id/w_b2_ic" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_walk" android:tint="#FFFFFFFF" android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_b2_tx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chôdza" android:textColor="#FFFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
        <LinearLayout android:id="@+id/w_b3" android:layout_width="44dp" android:layout_height="40dp" android:background="@drawable/wg_btn_secondary"
            android:gravity="center" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
            <ImageView android:id="@+id/w_b3_ic" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_nav" android:tint="#FFFFFFFF" android:scaleType="fitCenter" />
            
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
