<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg_walk" android:orientation="vertical" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/s_ring" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="fitCenter" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/s_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kroky dnes" android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/s_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFFFF" android:textSize="30sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.03" android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/s_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <TextView android:id="@+id/s_km" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:background="@drawable/wg_pill" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
                <TextView android:id="@+id/s_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFDE68A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:background="@drawable/wg_chip_warn" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/s_split" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:textColor="#CCFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <ImageView android:id="@+id/s_hours" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:scaleType="fitXY" android:visibility="gone" />
    <ImageView android:id="@+id/s_week" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp" android:layout_marginTop="10dp" android:scaleType="fitXY" />

</LinearLayout>
