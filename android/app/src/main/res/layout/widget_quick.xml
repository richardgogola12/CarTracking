<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg_idle" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:id="@+id/q_pill" android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/wg_pill"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="11dp">
            <ImageView android:id="@+id/q_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:scaleType="fitCenter" />
            <TextView android:id="@+id/q_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trasník" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView android:id="@+id/q_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="5dp" android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/q_btn1" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:layout_height="40dp" android:background="@drawable/wg_btn_primary"
            android:gravity="center" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
            <ImageView android:id="@+id/q_btn1_ic" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_car" android:tint="#FF0B1220" android:scaleType="fitCenter" />
            <TextView android:id="@+id/q_btn1_tx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jazda" android:textColor="#FF0B1220" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:layout_marginStart="6dp"/>
        </LinearLayout>
    <LinearLayout android:id="@+id/q_btn2" android:layout_width="44dp" android:layout_marginStart="6dp" android:layout_height="40dp" android:background="@drawable/wg_btn_secondary"
            android:gravity="center" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
            <ImageView android:id="@+id/q_btn2_ic" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_walk" android:tint="#FFFFFFFF" android:scaleType="fitCenter" />
            
        </LinearLayout>

</LinearLayout>
