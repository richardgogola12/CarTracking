<?xml version="1.0" encoding="utf-8"?>
<!-- Tento mesiac: km, jazdy, náklady, služobné, kroky + porovnanie s minulým mesiacom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/m_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_drive" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/m_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:text="📊 Tento mesiac" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/m_vs" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:background="@drawable/widget_tile" android:gravity="center"
            android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/m1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="–" />
            <TextView android:id="@+id/m1d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="10sp" android:text="km autom" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:background="@drawable/widget_tile" android:gravity="center"
            android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/m2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="–" />
            <TextView android:id="@+id/m2d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="10sp" android:text="jázd" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="0dp" android:background="@drawable/widget_tile" android:gravity="center"
            android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/m3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="–" />
            <TextView android:id="@+id/m3d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="10sp" android:text="náklady" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:background="@drawable/widget_tile" android:gravity="center"
            android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/m4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="–" />
            <TextView android:id="@+id/m4d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="10sp" android:text="služobne" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:background="@drawable/widget_tile" android:gravity="center"
            android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/m5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="–" />
            <TextView android:id="@+id/m5d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="10sp" android:text="kroky" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="0dp" android:background="@drawable/widget_tile" android:gravity="center"
            android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/m6" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="–" />
            <TextView android:id="@+id/m6d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="10sp" android:text="km pešo" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/m_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:minHeight="30dp" android:scaleType="fitXY" />
</LinearLayout>
